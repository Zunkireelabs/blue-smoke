{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "**/node_modules",
    "**/Pods",
    "tools/mock-peripheral/**",
    "supabase/functions/**",
    "tools/lint-guard/**",
    // P1-4.0 — imports tools/mock-peripheral/bleAdapter.ts (createMockPeripheral), which pulls in
    // deviceCore.ts/crypto.ts and their Buffer/node:crypto usage. "exclude" only keeps tsc from
    // picking a file up as a root entry point — it does NOT stop an included file's own imports
    // from being type-checked, so importing the mock from here pulls Buffer-typed files into a
    // program whose "types": ["jest"] deliberately excludes @types/node (see tools/mock-peripheral's
    // README, "Running it"). Jest itself is unaffected (babel-jest transpiles, doesn't type-check),
    // so this only opts the file out of `npm run typecheck`. See this PR's execution report §7 —
    // flagged as a finding, not silently worked around; P3-2.0/P3-3.0 will hit the same wall.
    "src/features/ble/__tests__/auth.test.ts"
  ]
}
