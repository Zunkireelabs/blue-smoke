{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "**/node_modules",
    "**/Pods",
    "tools/mock-peripheral/**",
    "supabase/functions/**",
    "tools/lint-guard/**",
    // P1-4.0 follow-up (execution brief §5) — auth.test.ts imports
    // tools/mock-peripheral/bleAdapter.ts (createMockPeripheral), which pulls in Buffer/node:crypto
    // usage that this program's "types": ["jest"] deliberately excludes (app code must not gain
    // Buffer). This file is no longer PERMANENTLY unchecked, though: it now type-checks under
    // tsconfig.test.json, a second program (types: ["node", "jest"]) that includes just this file
    // — same shape as tools/mock-peripheral's own tsconfig.json above, kept out of the root program
    // for the same reason and checked as its own `npm run typecheck` step instead. It still has to
    // stay in *this* exclude list, though: root's "include" is a broad "**/*.ts" glob, so without
    // this entry the root (Buffer-free) program would pick the file up as a root entry itself and
    // fail on the same Buffer/node:crypto errors tsconfig.test.json exists to avoid — confirmed by
    // removing this entry and running `npm run typecheck`. See this execution report's deviations.
    "src/features/ble/__tests__/auth.test.ts",
    // Same reason as auth.test.ts above — deviceInfo.test.ts also imports
    // tools/mock-peripheral/bleAdapter.ts, so it type-checks under
    // tsconfig.test.json instead.
    "src/features/ble/__tests__/deviceInfo.test.ts",
    // P2-6.0 (UI-BUILD-B) — bleSeam.acceptance.test.tsx also imports
    // tools/mock-peripheral/bleAdapter.ts, same reason as the two above.
    "src/features/ble/__tests__/bleSeam.acceptance.test.tsx"
  ]
}
