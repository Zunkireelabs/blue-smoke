<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- react-native-ble-plx — spec §4. Pre-31 devices need the legacy triad;
         API 31+ devices use the two scoped runtime permissions below. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- react-native-persona (P2-1.0) — ID capture + selfie, its SDK owns the camera UI. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- react-native-keychain (authKeychainStorage.ts) — the Supabase session is stored
         biometric-gated (spec §8, BIOMETRY_ANY_OR_DEVICE_PASSCODE). Without this permission
         declared, Android's BiometricManager reports NO biometric hardware to this app on
         API 28+ regardless of what the device actually has (react-native-keychain's own
         DeviceAvailability.kt checks Manifest.permission.USE_BIOMETRIC at runtime) — surfaced
         as CryptoFailedException "Fingerprint hardware not available" on a real device with a
         working, enrolled fingerprint sensor. USE_BIOMETRIC is a normal permission (no runtime
         prompt, auto-granted at install). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- @notifee/react-native (feature/ble-notification) — low-battery alert (POST_NOTIFICATIONS,
         API 33+) and the Android ongoing "connected" notification, which notifee implements as a
         foreground service of type connectedDevice (P1-7.0's OS-notification-bar half; the rest
         of that TODO item — reconnect/background-BLE-survival — is P1-7.0's own branch). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- P1-1.0 §3.2 — password-reset deep link (src/features/auth/deepLink.ts).
             Plain custom scheme, not an App Link — no verified domain exists for
             this project yet, so no autoVerify/assetlinks.json. Unverified
             on-device (brief §2). -->
        <intent-filter android:autoVerify="false">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="bluesmoke" android:host="reset-password" />
        </intent-filter>
      </activity>

      <!-- Overrides notifee's own merged manifest entry to declare foregroundServiceType,
           required on API 34+ for any FGS started with that type (notifee setup docs, Android
           foreground service guide). Name/exported must match notifee's library manifest
           exactly for the merge to target this service rather than duplicate it. -->
      <service
        android:name="app.notifee.core.ForegroundService"
        android:foregroundServiceType="connectedDevice"
        android:exported="false" />
    </application>
</manifest>
