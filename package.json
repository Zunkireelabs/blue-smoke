  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "bundle:check": "react-native bundle --platform ios --dev true --entry-file index.js --bundle-output /tmp/bundle-check-ios.bundle && react-native bundle --platform android --dev true --entry-file index.js --bundle-output /tmp/bundle-check-android.bundle",
    "bundle:check:release": "bash scripts/check-release-bundle-excludes-mock.sh",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools/mock-peripheral/tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
