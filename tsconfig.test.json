{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // P1-4.0 follow-up (execution brief §5) — importing
    // tools/mock-peripheral/bleAdapter.ts (createMockPeripheral) pulls in
    // deviceCore.ts/crypto.ts and their Buffer/node:crypto usage. The root
    // program's "types": ["jest"] deliberately excludes @types/node so app
    // code can't gain Buffer — this second program is the home for tests
    // that need Node ambients, instead of growing tsconfig.json's "exclude"
    // list every time one hits the same wall (P3-2.0/P3-3.0 will).
    "types": ["node", "jest"]
  },
  "include": [
    "src/features/ble/__tests__/auth.test.ts",
    "src/features/ble/__tests__/deviceInfo.test.ts",
    "src/features/ble/__tests__/scanner.test.ts",
    "src/features/ble/__tests__/base64.test.ts",
    "src/features/devices/__tests__/PairDeviceScreen.test.tsx",
    "src/features/ble/__tests__/connection.test.ts",
    "src/features/ble/__tests__/journey.test.ts",
    "src/features/ble/__tests__/appState.test.ts"
  ],
  // Root's "exclude" (inherited otherwise) lists this same file, so it must be overridden here —
  // that root entry exists to keep the file OUT of the root program, not out of this one.
  "exclude": []
}
