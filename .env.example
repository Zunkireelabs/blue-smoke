# .env.example
# Copy this to .env for local development. Never commit .env or .env.production.
# Keep this file up to date — it is the team's documentation for required variables.
#
# No VITE_ prefix — this is React Native, not Vite. The app reads these
# unprefixed via process.env (see src/shared/config/env.d.ts and
# src/shared/lib/supabaseClient.ts).

# ── DEV (default for local dev) ───────────────────────────────────────────────
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_ANON_KEY=your-dev-anon-key

# Persona (P2-1.0)
PERSONA_TEMPLATE_ID=itmpl_AW8e9aVphL2MHDmHsLFKScZsHNLPUA
PERSONA_ENVIRONMENT=sandbox

# Add more variables here as needed.
# Examples:
# API_URL=https://api-staging.example.com
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── STAGING (do not use these locally — for reference only) ─────────────────
# SUPABASE_URL=https://your-staging-project.supabase.co
# SUPABASE_ANON_KEY=your-staging-anon-key

# ── PRODUCTION (do not use these locally) ────────────────────────────────────
# SUPABASE_URL=https://your-prod-project.supabase.co
# SUPABASE_ANON_KEY=your-prod-anon-key
