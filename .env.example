# .env.example
# Copy this to .env for local development. Never commit .env or .env.production.
# Keep this file up to date — it is the team's documentation for required variables.

# ── STAGING (default for local dev) ──────────────────────────────────────────
VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-anon-key

# Add more variables here as needed.
# Examples:
# VITE_API_URL=https://api-staging.example.com
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── PRODUCTION (do not use these locally) ────────────────────────────────────
# VITE_SUPABASE_URL=https://your-prod-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-prod-anon-key
